# LLM-baseline provider credentials and model ids (examples/llm_baseline.py).
# Copy to .env (gitignored) and fill in the API keys of the providers you want to
# evaluate; providers without a key are skipped.
#
# Two model tiers are selected with --tier frontier|lightweight|both. A tier falls
# back to <PROVIDER>_MODEL if its own variable is unset.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

ANTHROPIC_MODEL_FRONTIER=claude-opus-5
ANTHROPIC_MODEL_LIGHTWEIGHT=claude-sonnet-5
OPENAI_MODEL_FRONTIER=gpt-5.6-sol
OPENAI_MODEL_LIGHTWEIGHT=gpt-5.6-luna
GEMINI_MODEL_FRONTIER=gemini-3.1-pro-preview
GEMINI_MODEL_LIGHTWEIGHT=gemini-3.6-flash
