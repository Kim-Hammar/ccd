# LLM-baseline provider credentials and model ids (examples/llm_baseline.py).
# Copy to .env (gitignored) and fill in the API keys of the providers you want to
# evaluate; providers without a key are skipped. Model ids can be overridden.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_MODEL=gpt-5.1
GEMINI_MODEL=gemini-2.5-pro
